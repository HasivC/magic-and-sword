{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Node 24 直接跑 .ts（类型擦除），不产出 JS。
    // 所以相对导入必须写 .ts 后缀，且只能用"可擦除"的语法。
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,

    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../schema/**/*.ts"]
}
